# ===============================================================
# SevaDesk Frontend - Environment Configuration
# ===============================================================

# Backend API URL:
# - For local development: leave empty (Vite automatically proxies /api to http://localhost:5000)
# - For Vercel deployment: Set this in Vercel Project Settings > Environment Variables:
#   VITE_API_URL=http://<YOUR_EC2_PUBLIC_IP>:5000
#   (or https://api.yourdomain.com if you have a custom domain with SSL)
VITE_API_URL=
